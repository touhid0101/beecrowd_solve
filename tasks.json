{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: Build and Run with MinGW",
      "type": "shell",
      // Added '& exit' at the very end to close the terminal session instance
      "command": "gcc \"${file}\" -o \"${fileDirname}\\program.exe\" && \"${fileDirname}\\program.exe\" & echo. & pause & exit",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": false,
        "echo": false,
        "showReuseMessage": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}